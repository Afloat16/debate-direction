# Documentation only. The CLI does not automatically load .env files.
# Set the selected provider's key in your shell or normal secret manager.
# Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional complete run configuration. A saved setup profile is simpler.
# DEBATE_PROVIDER=deepseek
# DEBATE_MODEL=deepseek-flash
# DEBATE_REASONING_EFFORT=high

# Optional alternate non-secret profile path:
# DEBATE_CONFIG=/path/to/debate-profile.json
# Optional OpenAI endpoint for explicit OpenAI runs:
# OPENAI_BASE_URL=https://api.openai.com/v1
